{
  "private": true,
  "name": "@ogun/example-electron",
  "productName": "Theia Electron Example",
  "version": "1.74.0",
  "main": "lib/backend/electron-main.js",
  "license": "EPL-2.0 OR GPL-2.0-only WITH Classpath-exception-2.0",
  "theia": {
    "target": "electron",
    "frontend": {
      "config": {
        "applicationName": "Theia Electron Example",
        "reloadOnReconnect": true,
        "electron": {
          "splashScreenOptions": {
            "content": "resources/theia-logo.svg",
            "height": 90
          },
          "appUserModelId": "EclipseTheia.ElectronExample"
        }
      }
    },
    "backend": {
      "config": {
        "frontendConnectionTimeout": -1,
        "configureProxyFromPreferences": true
      }
    }
  },
  "dependencies": {
    "@ogun/ai-anthropic": "1.74.0",
    "@ogun/ai-chat": "1.74.0",
    "@ogun/ai-chat-ui": "1.74.0",
    "@ogun/ai-claude-code": "1.74.0",
    "@ogun/ai-code-completion": "1.74.0",
    "@ogun/ai-codex": "1.74.0",
    "@ogun/ai-copilot": "1.74.0",
    "@ogun/ai-core": "1.74.0",
    "@ogun/ai-core-ui": "1.74.0",
    "@ogun/ai-editor": "1.74.0",
    "@ogun/ai-google": "1.74.0",
    "@ogun/ai-history": "1.74.0",
    "@ogun/ai-huggingface": "1.74.0",
    "@ogun/ai-ide": "1.74.0",
    "@ogun/ai-llamafile": "1.74.0",
    "@ogun/ai-mcp": "1.74.0",
    "@ogun/ai-mcp-server": "1.74.0",
    "@ogun/ai-mcp-ui": "1.74.0",
    "@ogun/ai-ollama": "1.74.0",
    "@ogun/ai-openai": "1.74.0",
    "@ogun/ai-registry": "1.74.0",
    "@ogun/ai-scanoss": "1.74.0",
    "@ogun/ai-terminal": "1.74.0",
    "@ogun/ai-tool-sketchpad": "1.74.0",
    "@ogun/api-provider-sample": "1.74.0",
    "@ogun/api-samples": "1.74.0",
    "@ogun/bulk-edit": "1.74.0",
    "@ogun/callhierarchy": "1.74.0",
    "@ogun/collaboration": "1.74.0",
    "@ogun/console": "1.74.0",
    "@ogun/core": "1.74.0",
    "@ogun/debug": "1.74.0",
    "@ogun/dev-container": "1.74.0",
    "@ogun/editor": "1.74.0",
    "@ogun/editor-preview": "1.74.0",
    "@ogun/electron": "1.74.0",
    "@ogun/external-terminal": "1.74.0",
    "@ogun/file-search": "1.74.0",
    "@ogun/filesystem": "1.74.0",
    "@ogun/getting-started": "1.74.0",
    "@ogun/keymaps": "1.74.0",
    "@ogun/markers": "1.74.0",
    "@ogun/memory-inspector": "1.74.0",
    "@ogun/messages": "1.74.0",
    "@ogun/metrics": "1.74.0",
    "@ogun/mini-browser": "1.74.0",
    "@ogun/monaco": "1.74.0",
    "@ogun/navigator": "1.74.0",
    "@ogun/outline-view": "1.74.0",
    "@ogun/output": "1.74.0",
    "@ogun/plugin-dev": "1.74.0",
    "@ogun/plugin-ext": "1.74.0",
    "@ogun/plugin-ext-headless": "1.74.0",
